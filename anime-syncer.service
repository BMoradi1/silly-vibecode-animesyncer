[Unit]
Description=Anime Syncer - Synchronized Video Streaming
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/anime-syncer
ExecStart=/usr/bin/node server.js
Restart=on-failure
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=anime-syncer
Environment=NODE_ENV=production
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
